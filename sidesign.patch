diff --git a/Sources/Models/AppBundle.swift b/Sources/Models/AppBundle.swift
index acf0c02..be483d4 100644
--- a/Sources/Models/AppBundle.swift
+++ b/Sources/Models/AppBundle.swift
@@ -34,6 +34,33 @@ public struct AppBundle: Sendable, Identifiable, Hashable, Equatable {
         loadExtensions()
     }
 
+    /// The watch app and its extensions are separate provisioning targets.
+    public func watchApplications() throws -> [AppBundle] {
+        try nestedBundles(in: "Watch", extension: "app")
+    }
+
+    public func watchExtensions() throws -> [AppBundle] {
+        try nestedBundles(in: "PlugIns", extension: "appex")
+    }
+
+    private func nestedBundles(in folder: String, extension suffix: String) throws -> [AppBundle] {
+        let root = fileURL.resolvingSymlinksInPath()
+        let container = root.appendingPathComponent(folder)
+        guard FileManager.default.fileExists(atPath: container.path) else { return [] }
+        guard container.resolvingSymlinksInPath().path == container.path else {
+            throw SignerError.invalidApp(cause: "Invalid nested bundle directory: \(folder)")
+        }
+        let children = try FileManager.default.contentsOfDirectory(at: container, includingPropertiesForKeys: nil)
+        return try children.filter { $0.pathExtension.lowercased() == suffix }
+            .sorted { $0.path < $1.path }.map { url in
+                guard url.resolvingSymlinksInPath().path == url.path,
+                      let bundle = AppBundle(fileURL: url) else {
+                    throw SignerError.invalidApp(cause: "Invalid embedded bundle: \(url.lastPathComponent)")
+                }
+                return bundle
+            }
+    }
+
     public var isExtension: Bool {
         fileURL.pathExtension.lowercased() == "appex"
     }
