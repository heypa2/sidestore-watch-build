diff --git a/Sources/Models/AppBundle.swift b/Sources/Models/AppBundle.swift
index acf0c02..0c785c0 100644
--- a/Sources/Models/AppBundle.swift
+++ b/Sources/Models/AppBundle.swift
@@ -34,6 +34,50 @@ public struct AppBundle: Sendable, Identifiable, Hashable, Equatable {
         loadExtensions()
     }
 
+    /// The watch app and its extensions are separate provisioning targets.
+    public func watchApplications() throws -> [AppBundle] {
+        try nestedBundles(in: "Watch", extension: "app")
+    }
+
+    public func watchExtensions() throws -> [AppBundle] {
+        try nestedBundles(in: "PlugIns", extension: "appex")
+    }
+
+    /// Translate a nested identifier using the host as it was read from the source IPA.
+    public func embeddedProfileIdentifier(for childID: String, replacingHostWith newHostID: String) throws -> String {
+        let prefix = bundleIdentifier + "."
+        guard childID.hasPrefix(prefix), childID.count > prefix.count else {
+            throw SignerError.invalidApp(cause: "Embedded identifier '\(childID)' is outside source host '\(bundleIdentifier)'.")
+        }
+        return newHostID + childID.dropFirst(bundleIdentifier.count)
+    }
+
+    private func nestedBundles(in folder: String, extension suffix: String) throws -> [AppBundle] {
+        let files = FileManager.default
+        let container = fileURL.appendingPathComponent(folder)
+        let attributes: [FileAttributeKey: Any]
+        do {
+            attributes = try files.attributesOfItem(atPath: container.path)
+        } catch let error as CocoaError where error.code == .fileReadNoSuchFile || error.code == .fileNoSuchFile {
+            return []
+        }
+        guard attributes[.type] as? FileAttributeType == .typeDirectory else {
+            throw SignerError.invalidApp(cause: "Invalid nested bundle directory: \(folder)")
+        }
+        let children = try files.contentsOfDirectory(at: container, includingPropertiesForKeys: nil)
+        return try children.filter { $0.pathExtension.lowercased() == suffix }
+            .sorted { $0.path < $1.path }.map { url in
+                let type = try files.attributesOfItem(atPath: url.path)[.type] as? FileAttributeType
+                guard type == .typeDirectory else {
+                    throw SignerError.invalidApp(cause: "Embedded target must be a directory: \(url.lastPathComponent)")
+                }
+                guard let bundle = AppBundle(fileURL: url) else {
+                    throw SignerError.invalidApp(cause: "Invalid embedded bundle: \(url.lastPathComponent)")
+                }
+                return bundle
+            }
+    }
+
     public var isExtension: Bool {
         fileURL.pathExtension.lowercased() == "appex"
     }
