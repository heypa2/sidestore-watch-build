@@ -0,0 +1,29 @@
+import Foundation
+import XCTest
+@testable import SideSign
+
+final class WatchCompanionTests: XCTestCase {
+    func testDiscoversWatchAndItsExtensionsSeparatelyFromPhonePlugins() throws {
+        let temp = FileManager.default.temporaryDirectory.appendingPathComponent(UUID().uuidString)
+        defer { try? FileManager.default.removeItem(at: temp) }
+        func makeBundle(_ path: String, _ id: String) throws -> AppBundle {
+            let directory = temp.appendingPathComponent(path)
+            try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+            let info = ["CFBundleIdentifier": id, "CFBundleExecutable": "Binary", "CFBundlePackageType": "APPL"]
+            let bytes = try PropertyListSerialization.data(fromPropertyList: info, format: .binary, options: 0)
+            try bytes.write(to: directory.appendingPathComponent("Info.plist"))
+            return try XCTUnwrap(AppBundle(fileURL: directory))
+        }
+        let host = try makeBundle("Example.app", "org.example.phone")
+        XCTAssertTrue(try host.watchApplications().isEmpty)
+        let watch = try makeBundle("Example.app/Watch/Companion.app", "org.example.phone.watch")
+        let ext = try makeBundle("Example.app/Watch/Companion.app/PlugIns/Logic.appex", "org.example.phone.watch.logic")
+        _ = try makeBundle("Example.app/PlugIns/Widget.appex", "org.example.phone.widget")
+        XCTAssertEqual(try host.watchApplications().map(\.bundleIdentifier), [watch.bundleIdentifier])
+        XCTAssertEqual(try watch.watchExtensions().map(\.bundleIdentifier), [ext.bundleIdentifier])
+        XCTAssertEqual(host.appExtensions.map(\.bundleIdentifier), ["org.example.phone.widget"])
+        let bad = host.fileURL.appendingPathComponent("Watch/Broken.app")
+        try FileManager.default.createDirectory(at: bad, withIntermediateDirectories: true)
+        XCTAssertThrowsError(try host.watchApplications())
+    }
+}
